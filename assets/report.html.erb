<!doctype html>
<html lang="en" data-theme="<%= h themes.first %>-<%= h(theme_mode(themes.first) || 'light') %>" data-mode="<%= h(theme_mode(themes.first) || 'light') %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="<%= csp %>">
  <meta name="dcr-ui" content="<%= ui_version %>">
<%- if served -%>
  <script>(function(){try{var b=<%= script_json(served.progress) %>;Object.keys(b).forEach(function(k){localStorage.setItem(k,JSON.stringify(b[k]))})}catch(e){}})()</script>
<%- end -%>
<%- if export -%>
  <script>(function(){try{var d=<%= script_json(export) %>;if(d.progress&&!localStorage.getItem(d.key))localStorage.setItem(d.key,JSON.stringify(d.progress));window.__DCR_EXPORT=d}catch(e){}})()</script>
<%- end -%>
  <title>Dynamic Code Review</title>
  <link rel="icon" type="image/svg+xml" href="<%= favicon %>">
  <script>try{var s=JSON.parse(localStorage.getItem('dynamic-review:settings')||'{}'),d=document.documentElement,t=<%= script_json(themes) %>,p=<%= script_json(theme_modes) %>,y=<%= script_json(theme_syntaxes) %>,n=t.indexOf(s.theme)<0?t[0]:s.theme,m=s.colorMode||p[n]||'system';m=m==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):m;d.dataset.mode=m;d.dataset.theme=n+'-'+m;d.dataset.syntax=s.syntaxTheme||y[n]||'classic'}catch(e){}</script>
  <style><%= styles %></style>
</head>
<body>
  <a class="skip-link" href="#content">Skip to review</a>
  <header class="app-header">
    <div class="brand" title="Dynamic Code Reviews"><span class="brand-icon" aria-hidden="true"><%= icon %></span></div>
    <div class="header-title"><strong id="title"></strong><span class="header-meta"><span id="repo-label"></span><span id="scope"></span></span></div>
    <div class="header-actions"><button class="header-button" id="preview-list-toggle" data-open-previews hidden>Previews</button><div id="revision-navigation"></div><button class="header-button" id="context-toggle">Details</button></div>
  </header>
  <div class="workspace">
    <aside class="sidebar" aria-label="Change groups">
      <div class="sidebar-heading"><strong>Walkthrough</strong><span id="file-total" class="badge neutral"></span></div>
      <input id="search" class="input input-bordered" type="search" placeholder="Find a file or step…" aria-label="Find a file or step">
      <nav id="navigation" aria-label="Review navigation"></nav>
      <div class="sidebar-footer"><span id="progress" role="status"></span><progress id="progress-bar" class="progress progress-primary" value="0" max="1" aria-label="Review progress"></progress></div>
    </aside>
    <div class="review-area">
      <div class="review-toolbar">
        <div class="toolbar-navigation"><button id="nav-toggle" class="icon-button" aria-expanded="false" aria-label="Toggle review navigation">☰</button><div class="pager"><button id="prev" class="icon-button" aria-label="Previous step">←</button><span id="position"></span><button id="next" class="icon-button" aria-label="Next step">→</button></div></div>
        <div class="toolbar-options">
          <button id="zen-toggle" class="icon-button" aria-label="Focus on this file" title="Focus on this file (F)"></button>
          <button id="ledger-toggle" class="icon-button ledger-toggle" aria-expanded="false" aria-controls="ledger" aria-label="Show your review" title="Your review"></button>
          <button id="view-toggle" class="view-toggle" popovertarget="view-menu" aria-haspopup="dialog" aria-expanded="false"><span id="view-icon" aria-hidden="true"></span><span class="view-label">View</span><span id="view-summary"></span></button>
        </div>
      </div>
      <main id="content" tabindex="-1"></main>
    </div>
    <aside id="ledger" class="ledger" aria-label="Your review" hidden>
      <div id="ledger-resize" class="ledger-resize" role="separator" aria-orientation="vertical" aria-label="Resize your review" title="" tabindex="0"><span class="ledger-resize-tip" aria-hidden="true">Drag to resize <b>↔</b></span></div>
      <header class="ledger-head"><h2>Your review</h2><button id="ledger-close" class="icon-button" aria-label="Close your review" title="Close"></button></header>
      <div id="ledger-body" class="ledger-body"></div>
      <footer id="ledger-footer" class="ledger-footer"></footer>
    </aside>
  </div>
  <div id="view-menu" class="view-menu" popover="auto" role="dialog" aria-label="Display settings">
    <section><h2>Reading</h2><fieldset class="segmented reading-modes" aria-label="Reading mode"><button id="focus" aria-pressed="true">File by file</button><button id="walkthrough" aria-pressed="false">Walkthrough</button></fieldset><p id="reading-hint" class="view-hint"></p></section>
    <section><h2>Diff</h2><fieldset class="segmented" role="group" aria-label="Diff layout"><button id="unified">Unified</button><button id="split">Split</button></fieldset></section>
    <section class="view-row"><label class="view-switch"><input id="comments-toggle" class="toggle toggle-sm toggle-primary" type="checkbox" checked><span>Review comments in the code</span></label></section>
    <section class="view-row"><label class="view-switch"><input id="whitespace-toggle" class="toggle toggle-sm toggle-primary" type="checkbox"><span>Ignore whitespace changes</span></label></section>
    <section><h2>Appearance</h2><fieldset class="segmented" role="group" aria-label="Colour mode"><button id="mode-system" data-color-mode="system">System</button><button id="mode-light" data-color-mode="light">Light</button><button id="mode-dark" data-color-mode="dark">Dark</button></fieldset><label class="view-select"><span>Theme</span><select id="theme" class="select select-sm select-bordered" aria-label="Theme"><%- themes.each do |name| -%><option value="<%= h name %>"<%- if (suited = theme_syntax(name)) -%> data-syntax="<%= h suited %>"<%- end -%><%- if (best = theme_mode(name)) -%> data-mode="<%= h best %>"<%- end -%>><%= h(name == 'aida' ? 'AIda' : name.capitalize) %></option><%- end -%></select></label><label class="view-select"><span>Syntax theme</span><select id="syntax-theme" class="select select-sm select-bordered" aria-label="Syntax theme"><option value="classic">Classic</option><option value="catppuccin">Catppuccin</option><option value="github">GitHub</option><option value="one">One</option><option value="solarized">Solarized</option><option value="dracula">Dracula</option></select></label></section>
    <section class="view-row"><span>Code size</span><div class="font-controls" role="group" aria-label="Code font size"><button id="font-smaller" class="icon-button" aria-label="Decrease code font size">A−</button><output id="font-size" aria-live="polite"></output><button id="font-larger" class="icon-button" aria-label="Increase code font size">A+</button></div></section>
    <section class="view-keys"><h2>Keyboard</h2><p><kbd>space</kbd> opens a menu of commands · <button type="button" class="link-button" data-open-keys><kbd>?</kbd> shows every key</button></p></section>
  </div>
  <dialog id="details-dialog" class="modal" aria-labelledby="details-title"><article class="modal-box"><header><button aria-label="Close review details" rel="prev" class="btn btn-sm btn-circle btn-ghost" id="close-details">✕</button><h2 id="details-title">Review details</h2></header><div id="review-details"></div><footer><button id="export" class="btn btn-sm btn-ghost">Export local notes</button><button class="btn btn-sm btn-primary" id="done-details">Done</button></footer></article></dialog>
  <div id="comment-popover" class="comment-popover" popover="auto" role="dialog" aria-labelledby="comment-popover-title"></div>
  <div id="range-actions" class="range-actions" hidden><div><strong id="range-label"></strong><small>Select another line to extend the range.</small></div><button id="write-comment" class="btn btn-sm btn-primary">Comment</button><button id="clear-range" class="btn btn-sm btn-ghost" aria-label="Clear selected range">✕</button></div>
  <dialog id="comment-editor" class="modal" aria-labelledby="editor-title"><form id="comment-form" class="modal-box"><header><h2 id="editor-title">Your comment</h2><button id="cancel-comment" type="button" class="btn btn-sm btn-circle btn-ghost" aria-label="Cancel comment">✕</button></header><p id="editor-location" class="comment-location"></p><pre id="editor-snippet" class="comment-snippet"></pre><label class="editor-label">Type<select id="editor-label" class="select select-bordered"><option value="note">Note</option><option value="question">Question</option><option value="suggestion">Suggestion</option><option value="issue">Issue</option></select></label><label class="editor-label">Comment<input id="editor-subject" class="input input-bordered" required placeholder="What should change, or what needs a closer look?"></label><label class="editor-label">Details <span class="muted">(optional)</span><textarea id="editor-discussion" class="textarea textarea-bordered" rows="3"></textarea></label><label class="editor-blocking"><input id="editor-blocking" type="checkbox" class="checkbox checkbox-sm"> Blocks approval</label><footer><span class="muted">Saved in this browser. Export a copy to keep it.</span><button type="submit" class="btn btn-sm btn-primary">Save comment</button></footer></form></dialog>
  <dialog id="send-dialog" class="modal" aria-labelledby="send-title"><div class="modal-box"><header><div><h2 id="send-title">Send your review</h2><p class="muted" id="send-hint">Choose what goes out. Comments you leave unticked stay with you.</p></div><button type="button" id="close-send" class="btn btn-sm btn-circle btn-ghost" aria-label="Close">✕</button></header><ul id="send-list" class="send-list"></ul><footer id="send-actions"><button type="button" id="send-copy" class="btn btn-sm btn-ghost">Copy for LLMs</button></footer></div></dialog>
  <dialog id="keys-dialog" class="modal" aria-labelledby="keys-title"><div class="modal-box keys-box"><header><h2 id="keys-title">Keyboard</h2><button type="button" class="btn btn-sm btn-circle btn-ghost" data-close aria-label="Close the list of keys">✕</button></header><p class="muted">The arrow keys do what <kbd>h</kbd> <kbd>j</kbd> <kbd>k</kbd> <kbd>l</kbd> do.</p><div class="keys-list"><section><h3>Anywhere</h3><dl><div><dt><kbd>space</kbd></dt><dd>A menu of commands for where you are</dd></div><div><dt><kbd>?</kbd></dt><dd>This list</dd></div><div><dt><kbd>/</kbd></dt><dd>Find a file or step</dd></div><div><dt><kbd>s</kbd></dt><dd>Label every link and button, then type one to click it</dd></div><div><dt><kbd>tab</kbd> or <kbd>h</kbd> <kbd>l</kbd></dt><dd>Move between the sidebar, the reading area and your review</dd></div><div><dt><kbd>1</kbd>–<kbd>9</kbd></dt><dd>Open that step</dd></div><div><dt><kbd>o</kbd></dt><dd>Overview</dd></div><div><dt><kbd>z</kbd></dt><dd>Switch between file by file and walkthrough</dd></div><div><dt><kbd>f</kbd></dt><dd>Focus mode</dd></div><div><dt><kbd>m</kbd></dt><dd>Mark the file viewed, or not</dd></div><div><dt><kbd>esc</kbd></dt><dd>Close what is open; leave a text</dd></div></dl></section><section><h3>In the sidebar</h3><dl><div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>Next and previous stop: Overview, All changes, then every file</dd></div></dl></section><section><h3>Reading a diff</h3><dl><div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>One line down or up</dd></div><div><dt><kbd>d</kbd> <kbd>u</kbd></dt><dd>Half a screen</dd></div><div><dt><kbd>g</kbd> <kbd>G</kbd></dt><dd>First and last line of the file</dd></div><div><dt><kbd>{</kbd> <kbd>}</kbd></dt><dd>The blank line before or after</dd></div><div><dt><kbd>[</kbd> <kbd>]</kbd></dt><dd>Previous and next changed section</dd></div><div><dt><kbd>c</kbd></dt><dd>Comment on the line</dd></div><div><dt><kbd>v</kbd></dt><dd>Start a range of lines; move to stretch it, then <kbd>c</kbd></dd></div><div><dt><kbd>e</kbd></dt><dd>Edit your comment on the line</dd></div><div><dt><kbd>enter</kbd></dt><dd>Read the comment on the line</dd></div></dl></section><section><h3>In your review</h3><dl><div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>Next and previous comment; scroll an open conversation</dd></div><div><dt><kbd>l</kbd> or <kbd>enter</kbd></dt><dd>Open the comment</dd></div><div><dt><kbd>i</kbd></dt><dd>Reply</dd></div><div><dt><kbd>h</kbd></dt><dd>Back to the list, then to the reading area</dd></div></dl></section><section><h3>In a text</h3><dl><div><dt><kbd>esc</kbd></dt><dd>Leave the text; <kbd>i</kbd> goes back in</dd></div><div><dt><kbd>⌘</kbd> <kbd>↵</kbd></dt><dd>Save or send</dd></div></dl></section></div></div></dialog>
  <dialog id="copy-dialog" class="modal" aria-labelledby="copy-title"><div class="modal-box"><h2 id="copy-title">Copy text</h2><p>Automatic copying is unavailable. Select and copy this text.</p><textarea id="copy-text" class="textarea textarea-bordered" readonly rows="12" aria-label="Review text to copy"></textarea><button id="close-copy" class="btn btn-sm btn-primary">Done</button></div></dialog>
  <dialog id="stage" class="stage" aria-labelledby="stage-title">
    <header class="stage-bar">
      <div class="stage-heading"><h2 id="stage-title">Previews</h2><p class="stage-sub" id="stage-sub"></p></div>
      <div class="stage-tools">
        <div class="stage-sizes" role="group" aria-label="Preview width"><button type="button" data-stage-width="390" title="Phone, 390 px"></button><button type="button" data-stage-width="768" title="Tablet, 768 px"></button><button type="button" data-stage-width="1280" title="Desktop, 1280 px"></button><button type="button" data-stage-width="fit" title="The full width of the window">Full</button></div>
        <div class="stage-sizes stage-height" role="group" aria-label="Parent height"><button type="button" data-stage-height="content" title="The parent wraps the content: the preview is as tall as it needs">Content</button><button type="button" data-stage-height="fit" title="The parent fills the height: for panes and pages that stretch to the window">Fit</button></div>
        <button type="button" class="act act-quiet" data-stage-code>View code</button>
        <button type="button" class="act act-secondary" data-stage-rebuild hidden></button>
        <button type="button" class="act act-quiet act-icon" data-stage-close aria-label="Close previews" title="Close (Esc)"></button>
      </div>
    </header>
    <div class="stage-body">
      <nav class="stage-rail" id="stage-rail" aria-label="Templates in this review"></nav>
      <section class="stage-canvas" aria-live="polite"><div class="stage-examples" id="stage-examples"></div><div class="stage-view" id="stage-view"></div><p class="stage-caption" id="stage-caption"></p></section>
    </div>
    <footer class="stage-foot" id="stage-foot" hidden></footer>
  </dialog>
  <dialog id="previews-dialog" class="modal" aria-labelledby="previews-title"><div class="modal-box preview-hub-box"><header><div><h2 id="previews-title">Template previews</h2><p class="muted">Rendered from the reviewed code with example data. Pick templates while reading, then ask your agent for all of them at once.</p></div><button type="button" id="close-previews" class="btn btn-sm btn-circle btn-ghost" aria-label="Close template previews">✕</button></header><div id="preview-hub"></div></div></dialog>
  <button id="zen-exit" class="zen-exit" hidden></button>
  <div id="toast" role="status" hidden></div>
  <script type="application/json" id="data"><%= data %></script>
  <script><%= scripts %></script>
<%- if served -%>
  <meta name="qa-token" content="<%= h served.token %>"><link rel="stylesheet" href="/style.css"><script src="/qa-panel.js"></script><script src="/recorder.js"></script>
  <link rel="stylesheet" href="/live.css"><script src="/live-tools.js"></script><script src="/live.js"></script>
<%- if served.app -%>
  <meta name="dcr-app" content="<%= h JSON.generate(served.app) %>"><link rel="stylesheet" href="/app-view.css"><script src="/app-view.js"></script>
<%- end -%>
  <script src="/try-band.js"></script>
<%- end -%>
<%- if export -%>
  <script><%= inline_script(live('live-tools.js')) %></script><script><%= inline_script(live('export-view.js')) %></script><style><%= live('live.css') %></style>
<%- end -%>
</body>
</html>
